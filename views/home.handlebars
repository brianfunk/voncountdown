
<div id="topper" class="parallax">
	<div id="cur_string">
		{{current_string}}
	</div>
	<div id="badger">
		<a href="https://github.com/brianfunk/voncountdown"><img src="/badge" alt="Von Countdown badge" /></a>
	</div>
</div>

<div id="numberimg" data-number="{{current_number}}">
</div>

<section id="twitter">
	<img src="/img/CountVonCount.jpg" title="Count Von Countdown" alt="Count Von Count"/>
	<div id="tweets">
		<div class="card">
			<div class="card-head">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="#412c88" aria-hidden="true">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
				<h3><a href="{{x_url}}" target="_blank" rel="noopener noreferrer">@VonCountdown</a></h3>
				<span class="card-sub">Recent counts</span>
			</div>
			{{#if recent_posts.length}}
			<ol class="feed">
				{{#each recent_posts}}
				<li>
					<a href="{{../x_url}}" target="_blank" rel="noopener noreferrer" class="feed-number">{{this.comma}}</a>
					<span class="feed-words">{{this.string}}</span>
					<span class="feed-when">{{this.when}}</span>
				</li>
				{{/each}}
			</ol>
			{{else}}
			<p class="feed-empty">The Count is clearing his throat. Ah ah ah!</p>
			{{/if}}
		</div>
	</div>
</section>

<div id="numbercom">
	{{current_comma}} and counting!!!!!!!!!!!!!!!!!!!!
</div>

<div id="vidpedia">

	<div id="ledger">
		<div class="card">
			<div class="card-head">
				<h3>The Count's Ledger</h3>
			</div>
			<dl class="ledger">
				<dt>Numbers counted</dt><dd>{{stats.countedSoFar}}</dd>
				<dt>Counting since</dt><dd>{{stats.countingSince}}</dd>
				<dt>Last count</dt><dd>{{stats.lastCount}}</dd>
				<dt>Pace</dt><dd>about {{stats.pacePerDay}} a day</dd>
				<dt>Numbers left</dt><dd>{{stats.numbersLeft}}</dd>
				<dt>Arrival at zero</dt><dd>{{stats.eta}} from now. Ah ah ah!</dd>
			</dl>
			<p class="card-foot">
				<a href="https://sesameworkshop.org/our-work/shows/sesame-street/sesame-street-characters/count-von-count/" target="_blank" rel="noopener noreferrer">About the Count on Sesame Workshop</a>
			</p>
		</div>
	</div>

	<div id="vidlaugh">
		<iframe width="395" height="220" src="https://www.youtube.com/embed/p3pKcRSmw2w?si=7H4BGY1rFMDfcvKP" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
	</div>

</div>

<div id="botter" class="parallax">
	<div id="followbtn">
		<a href="{{x_url}}" class="follow-link" target="_blank" rel="noopener noreferrer">Follow @VonCountdown on X</a>
	</div>
</div>

<script>
(function () {
	var holder = document.getElementById('numberimg');
	if (!holder) return;
	var digits = String(holder.dataset.number || '').replace(/[^0-9]/g, '');
	for (var i = 0; i < digits.length; i++) {
		var img = document.createElement('img');
		img.src = '/img/cvc_' + digits.charAt(i) + '.png';
		img.alt = 'Number ' + digits.charAt(i);
		holder.appendChild(img);
	}
})();
</script>
