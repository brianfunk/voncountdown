# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
DYNAMODB_TABLE=voncountdown

# Application Configuration
PORT=8080
NODE_ENV=development

# Twitter API Configuration
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# Optional: Logging
LOG_LEVEL=info

# Optional
# DRY_RUN=1          # log instead of posting to X / writing DynamoDB
# BOOT_DELAY_MS=5000 # pause before the first post after startup (default 5 minutes)

# Note: X API is pay-per-use. The account needs a prepaid credit balance or every post fails with 402.
